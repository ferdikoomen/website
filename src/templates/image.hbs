{{!--
    The "sizes" match the width of a gallery slide for each breakpoint (see _gallery.scss),
    the images are lazy loaded and the gallery script preloads the slides next to the current one.
--}}
<figure class="image" role="presentation" aria-hidden="true" tabindex="-1">
    <picture>
        <source type="image/avif" srcset="{{srcset "gallery" filename "avif"}}" sizes="(min-width: 1840px) 1760px, (min-width: 1560px) 1470px, (min-width: 1280px) 1170px, (min-width: 1000px) 880px, (min-width: 740px) 650px, 100vw"/>
        <img src="{{src "gallery" filename}}" srcset="{{srcset "gallery" filename "webp"}}" sizes="(min-width: 1840px) 1760px, (min-width: 1560px) 1470px, (min-width: 1280px) 1170px, (min-width: 1000px) 880px, (min-width: 740px) 650px, 100vw" width="1760" height="1100" alt="{{{ alt }}}" loading="lazy" decoding="async"/>
    </picture>
</figure>
