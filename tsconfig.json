{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom", "dom.iterable"],
        "types": [],
        "noEmit": true,
        "isolatedModules": true,
        "strict": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },

    "include": [
        "./src/ts/**/*.ts"
    ]
}
