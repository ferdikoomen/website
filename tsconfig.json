{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src/static/ts",
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2020", "dom"],
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "skipLibCheck": true
    },
    "include": ["./src/static/ts/**/*.ts"],
    "exclude": ["node_modules"]
}
